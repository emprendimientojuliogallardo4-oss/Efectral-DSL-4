# ================================================================
# EJEMPLO 03: TUBERÍA DE DATOS Y FLUJO SECUENCIAL
# Demuestra el paso de variables ($) y operador de tubería (->)
# Proyecto: Efectral Agents AI — E J G 4
# ================================================================

BloqueIdentidad:[
    @Identifícate(Agente:[AnalistaDeDatos])
    -Proyecto:[E J G 4]
    -Rol:[ProcesamientoDeArchivos]
]

BloqueReglas:[
    @Aplica(Hiperparametros:[Temperatura:0.2 - TopP:0.1])
    @Fija(Skin:[Directo]) MaximoOraciones:[2]
]

BloqueEjecucion:[
    # Flujo secuencial continuo sin pérdida de contexto
    1) !Verifica(Archivo:[README.md]) SiFalla:[Detén - EmiteAlerta:[ArchivoNoEncontrado] - EsperaInstrucciones]
    2) !Extrae(Archivo:[README.md]) Campos:[NombreProyecto, Fecha, ServidorOrigen] -> $Metadatos
    3) !Verifica(Datos:$Metadatos) -> $Validacion
    4) !Emite(Reporte:[AuditoriaCompletada]) Resumen:$Validacion ContratoSalida:[Tipo:DSL - MaxLineas:2]
    5) !EsperaInstrucciones
]
