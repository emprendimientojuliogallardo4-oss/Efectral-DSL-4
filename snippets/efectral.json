{
  "Agente Canónico": {
    "prefix": "agente-completo",
    "body": [
      "# ================================================================",
      "# AGENTE: ${1:NombreDelAgente} — EFECTRAL EFD",
      "# ================================================================",
      "",
      "BloqueIdentidad:[",
      "    @Identifícate(Agente:[${1:NombreDelAgente}]) Rol:[${2:RolPrincipal}] Organizacion:[${3:E J G 4}]",
      "    @Aplica(Regla:[Transparencia]) DeclararIA:[Si] SuplantarHumano:[No]",
      "]",
      "",
      "BloqueReglas:[",
      "    @Aplica(Hiperparametros:[Temperatura:0.2 - TopP:0.0])",
      "    @Fija(Skin:[Directo]) Intro:[No] MaximoOraciones:[2]",
      "    @Prohíbe(Exposicion:[PensamientoInterno]) SoloResultado:[Si]",
      "]",
      "",
      "BloqueSeguridad:[",
      "    @Prohíbe(Accion:[${4:BorrarDirectorio, ModificarSistema, MoverDinero}])",
      "    -AutorizacionExplicitaHumana:[RequeridaDeJulioGallardo]",
      "    SiFalla:[Detén - EmiteAlerta:[PeligroCritico] - EsperaInstrucciones]",
      "]",
      "",
      "BloqueEjecucion:[",
      "    1) !Verifica(Archivo:[${5:README.md}]) SiFalla:[Detén - EmiteAlerta:[FaltaArchivo] - EsperaInstrucciones]",
      "    2) !Extrae(Archivo:[${5:README.md}]) Campos:[${6:Campo1, Campo2}] -> \\$${7:Datos}",
      "    3) !Emite(Reporte:[${8:Resultado}]) Datos:\\$${7:Datos} Estado:[Conforme]",
      "    4) !EsperaInstrucciones",
      "]"
    ],
    "description": "Inserta el esqueleto completo de un agente normativo en Efectral EFD"
  },
  "Bloque Estructurado": {
    "prefix": "bloque",
    "body": [
      "Bloque${1:Nombre}:[",
      "    $0",
      "]"
    ],
    "description": "Crea un nuevo bloque estructurado en Efectral DSL"
  },
  "Directiva Dura (@)": {
    "prefix": "directiva",
    "body": [
      "@${1|Identifícate,Aplica,Fija,Prohíbe|}(${2:Parametro}:[${3:Valor}])$0"
    ],
    "description": "Inserta una directiva inviolable con @"
  },
  "Accion Imperativa (!)": {
    "prefix": "accion",
    "body": [
      "${1:1}) !${2|Verifica,Extrae,Escribe,Ejecuta,Emite,EsperaInstrucciones|}(${3:Objeto}:[${4:Recurso}])$0"
    ],
    "description": "Inserta una orden ejecutiva activa con !"
  },
  "Cortocircuito SiFalla": {
    "prefix": "sifalla",
    "body": [
      "SiFalla:[Detén - EmiteAlerta:[${1:AlertaCritica}] - EsperaInstrucciones]$0"
    ],
    "description": "Inserta una cláusula de cortocircuito estricta ante excepciones"
  },
  "Tuberia y Variable": {
    "prefix": "tuberia",
    "body": [
      "-> \\$${1:DatosResultado}$0"
    ],
    "description": "Conecta la salida a un registro de variable"
  },
  "Carga Selectiva Kernel": {
    "prefix": "carga-selectiva",
    "body": [
      "BloqueCargaSelectiva:[",
      "    @Aplica(PrincipioKernel:[MinimoContexto])",
      "    @Prohíbe(CargaMonolitica:[CargarHerramientasSinDemandaActiva])",
      "",
      "    [Demanda:${1:TipoDemanda}] -> !Aplica(Montar:[${2:Modulo.efd}])",
      "    [Demanda:General] -> !Aplica(MontarMinimo:[IDENTITY.efd, SOUL.efd])",
      "]$0"
    ],
    "description": "Inserta el bloque de carga selectiva bajo demanda estilo Kernel Linux"
  },
  "Bifurcacion Condicional": {
    "prefix": "bifurcacion",
    "body": [
      "[${1:Demanda/Condicion}:${2:Patron}] -> !${3|Aplica,Verifica,Ejecuta,Emite|}(${4:Parametro}:[${5:Valor}])$0"
    ],
    "description": "Inserta una sentencia de bifurcación condicional / pattern matching"
  }
}
