# ================================================================
# Efectral Native v1 — HEARTBEAT.efd
# Rutina de Latido y Mantenimiento Periódico del Gateway
# Organización: E J G 4 — Julio César Gallardo
# ================================================================

BloqueIdentidad:[
    @Identifícate(Modulo:[Latido_Y_Mantenimiento_Efectral_4_Native])
    -Frecuencia:[Automatica_Por_OpenClaw]
]

BloqueReglas:[
    @Aplica(Modo:[Silencioso]) # Ejecutar en segundo plano sin saturar canales
    @Prohíbe(Modificacion:[MEMORY.md_SinDestilacionPrevia])
]

BloqueEjecucion:[
    # Ciclo de Autolimpieza y Síntesis
    1) !Verifica(Buffer:[working-buffer.md]) 
       SiFalla:[Detén - EsperaInstrucciones]

    2) !Extrae(DecisionesValiosas:[working-buffer.md]) -> $NuevosHechos

    3) !Destila(Entrada:[$NuevosHechos], Destino:[MEMORY.md])

    4) !Limpia(Buffer:[working-buffer.md])

    5) !Verifica(SaludGateway:[ConexionesCanales, MemoriaHost]) -> $Diagnostico

    6) !Registra(Auditoria:[$Diagnostico])
]

BloqueSeguridad:[
    SiFalla:[EmiteAlerta:[FalloEnCicloDeLatido]]
]
