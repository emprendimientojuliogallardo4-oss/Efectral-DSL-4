{
  "$schema": "https://openclaw.ai/schemas/workspace-config.json",
  "name": "Efectral Native v1",
  "version": "1.0.0",
  "description": "Sistema Agéntico Modelo en Blanco — OpenClaw + Efectral DSL",
  "organization": "E J G 4",
  "author": "Julio César Gallardo",
  "framework": {
    "engine": "OpenClaw",
    "gateway": "https://github.com/openclaw/openclaw",
    "promptLanguage": "Efectral DSL (.efd)",
    "specification": "1.0.0"
  },
  "workspace": {
    "identity": "IDENTITY.efd",
    "soul": "SOUL.efd",
    "agents": "AGENTS.efd",
    "tools": "TOOLS.efd",
    "heartbeat": "HEARTBEAT.efd",
    "user": "USER.efd",
    "memory": "MEMORY.efd",
    "sessionState": "SESSION-STATE.efd",
    "workingBuffer": "working-buffer.efd"
  },
  "runtime": {
    "temperature": 0.2,
    "topP": 0.1,
    "maxTokens": 4096,
    "singleThreaded": true,
    "strictSyntax": true
  }
}
