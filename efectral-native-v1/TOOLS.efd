# ================================================================
# Efectral Native v1 — TOOLS.efd
# Catálogo y Ruteo Dinámico de Herramientas OpenClaw
# Organización: E J G 4 — Julio César Gallardo
# ================================================================

BloqueIdentidad:[
    @Identifícate(Modulo:[Ruteo_Herramientas_Efectral_4_Native])
]

BloqueReglas:[
    # Ley de la Metodología Efectualista
    @Aplica(Principio:[PajaroEnMano])
    @Prohíbe(Invocacion:[HerramientasFicticias, ServiciosNoInstalados])
    
    # Precondición estricta de verificación
    @Exige(VerificacionPrevia:[DisponibilidadFisicaEnHost])
]

BloqueEjecucion:[
    # Ruteo Funcional OpenClaw Gateway
    [Demanda:LecturaArchivos]     -> !Verifica(Ruta:[$Ruta]) -> !Extrae(Contenido:[$Ruta])
    [Demanda:EscrituraArchivos]   -> !Verifica(Permiso:[Escritura]) -> !Escribe(Destino:[$Destino])
    [Demanda:EjecucionComandos]   -> !Verifica(Seguridad:[NoDestructivo]) -> !Ejecuta(Comando:[$Comando])
    [Demanda:GestionGit]          -> !Ejecuta(Herramienta:[Git], Operacion:[$Operacion])
    [Demanda:OperacionFinanciera] -> !Exige(Autorizacion:[JulioGallardo]) -> !Ejecuta(API:[cTrader])
    
    # Crecimiento en Vivo: Montaje de nuevas capacidades solicitadas por el operador
    [Demanda:NuevaHerramienta]    -> !Verifica(RecursoEnHost:[$Recurso]) -> !Monta(Capacidad:[$Recurso])

    SiFalla:[Detén - EmiteAlerta:[HerramientaNoDisponible] - EsperaInstrucciones]
]

BloqueSeguridad:[
    @Prohíbe(Acceso:[ClavesSSH, Credenciales, ArchivosEnv, LogsSesion])
    SiFalla:[Detén - EmiteAlerta:[IntentoViolacionSeguridad] - EsperaInstrucciones]
]
