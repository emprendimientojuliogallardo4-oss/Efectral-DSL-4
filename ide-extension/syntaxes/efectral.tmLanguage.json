{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Efectral DSL",
  "scopeName": "source.efd",
  "fileTypes": ["efd"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#directives" },
    { "include": "#actions" },
    { "include": "#ordinals" },
    { "include": "#pipelines" },
    { "include": "#variables" },
    { "include": "#booleans" },
    { "include": "#numbers" },
    { "include": "#keys" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.efd",
      "match": "#.*$"
    },
    "strings": {
      "name": "string.quoted.double.efd",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.efd",
          "match": "\\\\."
        }
      ]
    },
    "directives": {
      "match": "(@)([A-Za-zÁ-Úá-úÑñ0-9_]+)\\b",
      "captures": {
        "1": { "name": "keyword.operator.directive.efd" },
        "2": { "name": "entity.name.function.directive.efd" }
      }
    },
    "actions": {
      "match": "(!)([A-Za-zÁ-Úá-úÑñ0-9_]+)\\b",
      "captures": {
        "1": { "name": "keyword.operator.action.efd" },
        "2": { "name": "keyword.control.action.efd" }
      }
    },
    "ordinals": {
      "match": "\\b([0-9]+\\))",
      "captures": {
        "1": { "name": "constant.numeric.ordinal.efd" }
      }
    },
    "pipelines": {
      "match": "->",
      "name": "keyword.operator.pipeline.efd"
    },
    "variables": {
      "match": "(\\$)([A-Za-zÁ-Úá-úÑñ0-9_]+)",
      "captures": {
        "1": { "name": "punctuation.definition.variable.efd" },
        "2": { "name": "variable.other.efd" }
      }
    },
    "booleans": {
      "match": "\\b(Si|No)\\b",
      "name": "constant.language.boolean.efd"
    },
    "numbers": {
      "match": "\\b[0-9]+(?:\\.[0-9]+)+\\b|\\b[0-9]+\\b",
      "name": "constant.numeric.efd"
    },
    "keys": {
      "match": "(-?\\b[A-Za-zÁ-Úá-úÑñ0-9_]+):",
      "captures": {
        "1": { "name": "support.type.property-name.efd" }
      }
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[\\[\\]]",
          "name": "punctuation.section.brackets.efd"
        },
        {
          "match": "[\\(\\)]",
          "name": "punctuation.section.parens.efd"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.efd"
        },
        {
          "match": "\\b(SiFalla)\\b",
          "name": "keyword.control.exception.efd"
        }
      ]
    }
  }
}
