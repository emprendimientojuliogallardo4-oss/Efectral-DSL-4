(* ================================================================ *)
(* Efectral DSL — Gramática Formal Normativa en Notación EBNF   *)
(* Proyecto: Efectral Agents AI — E J G 4                          *)
(* Autor: Julio César Gallardo                                     *)
(* ================================================================ *)

programa          = { bloque | instruccion | bloque_parser } ;

bloque            = identificador , ":[" , { elemento_bloque } , "]" , salto_linea ;
elemento_bloque   = directiva | instruccion | bifurcacion | declaracion | bloque_parser ;

directiva         = "@" , verbo_directiva , "(" , [ lista_argumentos ] , ")" , { parametro } ;
verbo_directiva   = identificador ; (* Canon: Identifícate, Aplica, Fija, Prohíbe, Exige, Restringe *)

instruccion       = [ indice_ordinal ] , "!" , verbo_accion , [ "(" , [ lista_argumentos ] , ")" ] , { parametro } , [ tuberia ] ;
verbo_accion      = identificador ; (* Canon: Verifica, Extrae, Escribe, Ejecuta, Emite, EsperaInstrucciones, Revisa, Audita *)

bifurcacion       = "[" , condicion , "]" , "->" , ( instruccion | directiva | variable | "[" , valor , "]" ) ;
condicion         = ( identificador , [ ":" , valor ] ) | expresion_logica ;
expresion_logica  = ( variable | identificador ) , [ espacio ] , operador_logico , [ espacio ] , valor ;
operador_logico   = "==" | "!=" | ">" | "<" | ">=" | "<=" ;
espacio           = " " ;

indice_ordinal    = numero , ")" ;
tuberia           = "->" , variable ;
variable          = "$" , identificador ;

declaracion       = [ "-" ] , identificador , ":[" , valor , "]" ;
parametro         = [ "-" ] , identificador , ":[" , valor , "]" | identificador , ":" , cadena ;

lista_argumentos  = argumento , { "," , argumento } ;
argumento         = identificador , ":[" , valor , "]" | identificador | valor ;

valor             = simple | compuesto | secuencia ;
simple            = identificador | numero | booleano | cadena ;
compuesto         = "[" , valor , { "-" , valor } , "]" ;
secuencia         = "[" , valor , "]" , { "-" , "[" , valor , "]" } ;

booleano          = "Si" | "No" ;
identificador     = letra_mayuscula , { letra | digito | "_" } ;
cadena            = '"' , { cualquier_caracter - '"' } , '"' ;
numero            = digito , { digito } , [ "." , digito , { digito } ] ;
bloque_parser     = "#" , identificador_parser , { cualquier_caracter } , "#Fin" ;
identificador_parser = { letra | digito | "_" | "-" } ;

letra             = "A".."Z" | "a".."z" | "Á".."Ú" | "á".."ú" | "Ñ" | "ñ" ;
letra_mayuscula   = "A".."Z" | "Á".."Ú" | "Ñ" ;
digito            = "0".."9" ;
salto_linea       = "\n" | "\r\n" ;
